  "renderCheckbox": {
    "rows": [
      {
        "when": {
          "field": "status",
          "equals": "open"
        },
        "then": "[ ]"
      },
      {
        "when": {
          "field": "status",
          "equals": "done"
        },
        "then": "[x]"
      },
      {
        "when": {
          "field": "status",
          "equals": "in_progress"
        },
        "then": "[/]"
      },
      {
        "when": {
          "field": "status",
          "equals": "cancelled"
        },
        "then": "[-]"
      },
      {
        "when": {
          "field": "status",
          "equals": "waiting"
        },
        "then": "[~]"
      },
      {
        "when": {
          "field": "status",
          "equals": "scheduled"
        },
        "then": "[>]"
      }
    ],
    "fallback": "[ ]"
  },
