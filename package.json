{
  "name": "qntm-network-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The qntm.network browser application \u2014 markdown rendering and editing. See docs/architecture/capabilities.yaml, 'the application stratum'.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm run typecheck && npm run build && npm test",
    "check:declarations": "node scripts/checkdeclarations.mjs",
    "check:operations": "node scripts/check-operation-completeness.mjs",
    "generate:structural": "node scripts/generate-structural-declaration.mjs",
    "generate:structural:check": "node scripts/generate-structural-declaration.mjs --check",
    "generate:qualification": "node scripts/generate-qualification-declaration.mjs",
    "generate:qualification:check": "node scripts/generate-qualification-declaration.mjs --check",
    "generate:resolution": "node scripts/generate-resolution-declaration.mjs",
    "generate:resolution:check": "node scripts/generate-resolution-declaration.mjs --check",
    "generate:operator-set": "node scripts/generate-operator-set.mjs",
    "generate:operator-set:check": "node scripts/generate-operator-set.mjs --check",
    "generate:rules": "node scripts/generate-rules-declaration.mjs",
    "generate:rules:check": "node scripts/generate-rules-declaration.mjs --check"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2"
  }
}
